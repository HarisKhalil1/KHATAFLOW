# KhataFlow — Environment Configuration Template
# ----------------------------------------------------
# This project runs client-side state / demo mode out of the box with zero required credentials.
# No secret API keys or database passwords are required for local development.
# If integrating future third-party services, add placeholder keys here:

# Application
NEXT_PUBLIC_APP_NAME="KhataFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future Database / Backend (Placeholders only - DO NOT commit real credentials)
# DATABASE_URL="postgresql://user:password@localhost:5432/khataflow"
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-placeholder-anon-key"
